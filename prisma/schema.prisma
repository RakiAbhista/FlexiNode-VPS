generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  balance       Int            @default(0)
  suspended     Boolean        @default(false)
  emailVerified Boolean        @default(true)
  githubHandle  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  githubToken   String?
  orders        Order[]
  transactions  Transaction[]
  tutorialPrefs TutorialPref[]
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  durationDays Int
  ramMb        Int
  cpuAllowance Int
  storageGb    Int
  price        Int
  active       Boolean  @default(true)
  tier         String   @default("Starter")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id           String        @id @default(uuid())
  userId       String
  planId       String
  status       OrderStatus   @default(ACTIVE)
  serverStatus String        @default("RUNNING") // RUNNING | STOPPED
  containerId  String?
  ipAddress    String?
  subdomain        String?
  sshPassword      String?       // Password root untuk akses SSH customer
  addon            Boolean       @default(false)  // true = kustomer beli paket subdomain+CI/CD
  addonPrice       Int           @default(0)
  addonSuspended   Boolean       @default(false)  // true = addon disuspend (grace period 24 jam)
  addonSuspendedAt DateTime?                      // Waktu ketika addon disuspend
  setupPackages    String?                        // JSON array string of auto-installed setups, e.g. ["nodejs","git"]
  startedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  plan         Plan          @relation(fields: [planId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  metrics      ContainerMetric[]
}

model Transaction {
  id         String            @id @default(uuid())
  userId     String
  type       TransactionType
  amount     Int
  method     PaymentMethod     @default(BALANCE)
  status     TransactionStatus @default(SUCCESS)
  orderId    String?
  gatewayRef String?
  createdAt  DateTime          @default(now())
  order      Order?            @relation(fields: [orderId], references: [id])
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TutorialPref {
  id        String   @id @default(uuid())
  userId    String
  pageKey   String
  dismissed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
}

model AppConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  GUEST
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROVISIONING
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  FAILED
}

enum TransactionType {
  TOPUP
  RENTAL
  EXTEND
}

enum PaymentMethod {
  BALANCE
  GATEWAY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model ContainerMetric {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cpu         Int      @default(0)
  ramPercent  Int      @default(0)
  ramMb       Int      @default(0)
  ramTotalMb  Int      @default(512)
  diskGb      Float    @default(0)
  diskTotalGb Float    @default(10)
  networkRxMb Float    @default(0)
  networkTxMb Float    @default(0)
  uptime      String?
  online      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}
